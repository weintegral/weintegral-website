{
    "name": "weintegral/weintegral-website",
    "type": "project",
    "description": "The WeIntegral Website.",
    "keywords": [
        "weintegral",
        "website"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.16",
        "laravel/framework": "^13.38",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "mettle/sendportal-core": "^4.0",
        "opcodesio/log-viewer": "^3.24",
        "orchid/platform": "^14.53",
        "sentry/sentry-laravel": "^4.29",
        "wotz/laravel-swagger-ui": "^2.1",
        "zircote/swagger-php": "^6.18"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/dusk": "^8.7",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "laravel/telescope": "^5.26",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "api-docs:generate": "openapi app -f json -o resources/swagger/openapi.json -v"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
