# Dusk swaps this file over .env during `php artisan dusk`.
# The suffix must match APP_ENV, and docker/.docker.env sets APP_ENV=development as a
# real container env var, so Dusk looks for .env.dusk.development (not .env.dusk.local).
# APP_KEY here only encrypts throwaway sqlite test data.

APP_NAME=WeIntegralWebsite
APP_ENV=development
APP_KEY=base64:Z9dOGXrw5KeSR+m+i0JWjdoEgvHPxzE8oQ8G3gnYe58=
APP_DEBUG=true
APP_URL=http://we-webserver

DUSK_DRIVER_URL=http://we-selenium:4444

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/dusk.sqlite

CACHE_DRIVER=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array

TELESCOPE_ENABLED=false
SENTRY_LARAVEL_DSN=
