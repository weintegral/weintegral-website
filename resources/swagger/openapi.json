                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error creating visitor request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Error creating visitor request"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
